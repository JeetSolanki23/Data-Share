# ============================================================================
# SECURITY
# ============================================================================
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ENVIRONMENT=development

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================
# Local storage directory path (default: ./storage)
STORAGE_DIR=./storage

# ============================================================================
# UPLOAD LIMITS
# ============================================================================
# Per-file size limit in bytes (0 = unlimited)
MAX_UPLOAD_SIZE=0

# Max files allowed per upload (0 = unlimited)
MAX_FILES_PER_UPLOAD=10

# Total storage quota in MB (0 = unlimited)
TOTAL_STORAGE_QUOTA_MB=1024

# Uploads per minute per IP (0 = unlimited)
UPLOADS_PER_MINUTE=5

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Optional: Use PostgreSQL instead of SQLite
# Format: postgres://user:password@host:port/database
# Leave empty to use SQLite
DATABASE_URL=

# Database connection pool settings
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ============================================================================
# CLOUDINARY (Optional)
# ============================================================================
# Format: cloudinary://api_key:api_secret@cloud_name
# Leave empty to use local storage only
CLOUDINARY_URL=

# ============================================================================
# RATE LIMITING
# ============================================================================
# Redis URI for distributed rate limiting (optional)
# Format: redis://host:port
# Leave empty for memory-based rate limiting
RATE_LIMIT_STORAGE_URL=

# ============================================================================
# REQUEST HANDLING
# ============================================================================
# Request timeout in seconds
REQUEST_TIMEOUT_SEC=300

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Server port
PORT=5000

# Debug mode (set to 'False' in production)
DEBUG=False

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Testing mode (set to 'True' only for tests)
TESTING=False

# Optional: override the local storage directory. Default in app is /tmp/storage
# STORAGE_DIR=
